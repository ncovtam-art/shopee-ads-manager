# Lấy từ Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Exact browser Origin. Configure separately for each Vercel Preview/Production.
APP_ORIGIN=http://localhost:3000
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# No live automation is enabled by this release.
DRY_RUN=true
META_AUTO_ACTIVATE=false
AI_LIVE_ENABLED=false
